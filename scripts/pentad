#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage:' \
    '  pentad start [--development | --path INSTALL_ROOT] [--safe-mode]' \
    '  pentad dev [--safe-mode]' \
    '  pentad stop|restart|status|logs [--development | --path INSTALL_ROOT]' \
    '  pentad lock [--development | --path INSTALL_ROOT]' \
    '  pentad doctor [--development | --path INSTALL_ROOT]' \
    '  pentad setup [--undo] [--development | --path INSTALL_ROOT]' \
    '  pentad recolor-wallpaper <input> [output] [--stops 0:#RRGGBB,...,1:#RRGGBB]' \
    '  pentad wallpaper <random|next|previous|set PATH> [--development | --path INSTALL_ROOT]' \
    '  pentad ping [--development | --path INSTALL_ROOT]' \
    '  pentad screenshot <edit|copy|window|monitor|settings> [--development | --path INSTALL_ROOT]' \
    '  pentad panel <left|right|activity> <open|close|toggle> [--development | --path INSTALL_ROOT]' \
    '  pentad workspace-super <Super_L|Super_R> <press|release> [--development | --path INSTALL_ROOT]' \
    '  pentad workspace-slot <1..9> [--development | --path INSTALL_ROOT]' \
    '  pentad overview <open|close|toggle> [--development | --path INSTALL_ROOT]' \
    '  pentad window-switcher <all|application> <next|previous|commit|cancel> [--development | --path INSTALL_ROOT]'
}

command_name=${1-}
[ "$#" -gt 0 ] && shift || true
script_path=$(realpath -- "$0" 2>/dev/null) || script_path=$0
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
# Installed as PREFIX/bin/pentad, the runtime is PREFIX/share/pentad/quickshell for any PREFIX.
default_root=$script_dir/../share/pentad/quickshell
if [ -d "$default_root" ]; then
  default_root=$(CDPATH= cd -- "$default_root" && pwd)
else
  default_root=/usr/share/pentad/quickshell
fi
# A checkout keeps helpers in tools/; an installed runtime carries them in helpers/.
helper_path() {
  for candidate in "$script_dir/../tools/$1" "$2/helpers/$1"; do
    [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
  done
  printf 'Pentad helper is missing: %s\n' "$1" >&2
  return 1
}
# When `pentad lock` cannot lock, the session must still be locked: hand over to hyprlock.
lock_fallback() {
  if command -v hyprlock >/dev/null 2>&1; then
    echo 'Starting hyprlock instead.' >&2
    exec hyprlock
  fi
  echo 'No fallback locker is installed; install hyprlock to keep one.' >&2
  exit "$1"
}
if [ "$command_name" = dev ]; then
  exec node "$script_dir/dev-quickshell.mjs" "$@"
fi
if [ "$command_name" = recolor-wallpaper ]; then
  command -v python3 >/dev/null 2>&1 || { echo "Python 3 is required for wallpaper recoloring." >&2; exit 127; }
  recolor_helper=$(helper_path pentad_recolor_wallpaper.py "$default_root") || exit 1
  exec python3 "$recolor_helper" "$@"
fi
ipc_payload='{}'
case "$command_name" in
  screenshot)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    case "$1" in edit|copy|window|monitor|settings) ;; *) usage >&2; exit 2 ;; esac
    ipc_payload=$(printf '{"mode":"%s"}' "$1")
    shift
    ;;
  overview)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    case "$1" in open|close|toggle) ;; *) usage >&2; exit 2 ;; esac
    ipc_payload=$(printf '{"action":"%s"}' "$1")
    shift
    ;;
  window-switcher)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    case "$1" in all|application) ;; *) usage >&2; exit 2 ;; esac
    case "$2" in next|previous|commit|cancel) ;; *) usage >&2; exit 2 ;; esac
    ipc_payload=$(printf '{"mode":"%s","action":"%s"}' "$1" "$2")
    shift 2
    ;;
  workspace-super)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    case "$1" in Super_L|Super_R) ;; *) usage >&2; exit 2 ;; esac
    case "$2" in press|release) ;; *) usage >&2; exit 2 ;; esac
    ipc_payload=$(printf '{"key":"%s","action":"%s"}' "$1" "$2")
    shift 2
    ;;
  workspace-slot)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    case "$1" in [1-9]) ;; *) usage >&2; exit 2 ;; esac
    ipc_payload=$(printf '{"slot":%s}' "$1")
    shift
    ;;
  panel)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    case "$1" in left|right|activity) ;; *) usage >&2; exit 2 ;; esac
    case "$2" in open|close|toggle) ;; *) usage >&2; exit 2 ;; esac
    ipc_payload=$(printf '{"surface":"%s","action":"%s"}' "$1" "$2")
    shift 2
    ;;
  wallpaper)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    case "$1" in
      random|next|previous)
        ipc_payload=$(printf '{"action":"%s"}' "$1")
        shift
        ;;
      set)
        [ "$#" -ge 2 ] || { usage >&2; exit 2; }
        wallpaper_path=$(realpath -e -- "$2") || exit 1
        case "$wallpaper_path" in
          *'"'*|*'\'*) echo 'Wallpaper path cannot contain quotes or backslashes.' >&2; exit 2 ;;
        esac
        ipc_payload=$(printf '{"action":"set","path":"%s"}' "$wallpaper_path")
        shift 2
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
esac
mode=install
install_root=$default_root
safe_mode=0
setup_undo=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --development) mode=development; shift ;;
    --path)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      mode=path; install_root=$2; shift 2
      ;;
    --safe-mode) safe_mode=1; shift ;;
    --undo)
      [ "$command_name" = setup ] || { echo '--undo applies only to setup' >&2; exit 2; }
      setup_undo=1; shift
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2; usage >&2
      # A typo in hypridle's lock_cmd must not leave the session unlocked.
      [ "$command_name" != lock ] || lock_fallback 2
      exit 2
      ;;
  esac
done

case "$command_name" in
  start|stop|restart|status|logs|lock|doctor|setup|ping|panel|workspace-super|workspace-slot|overview|window-switcher|screenshot|wallpaper) ;;
  *) usage >&2; exit 2 ;;
esac
case "$command_name" in
  start|restart) ;;
  *) [ "$safe_mode" -eq 0 ] || { echo '--safe-mode applies only to start or restart' >&2; exit 2; } ;;
esac

repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
qs_binary=qs
if [ "$mode" = development ]; then
  install_root=$repo_dir/dist/quickshell
  if [ -x "$repo_dir/artifacts/quickshell-runtime/bin/qs" ]; then
    qs_binary=$repo_dir/artifacts/quickshell-runtime/bin/qs
  fi
fi
if [ "$command_name" = restart ] && [ "$mode" = development ]; then
  if [ "$safe_mode" -eq 1 ]; then
    exec node "$script_dir/dev-quickshell.mjs" --once --safe-mode
  else
    exec node "$script_dir/dev-quickshell.mjs" --once
  fi
fi
if [ "$command_name" = doctor ]; then
  command -v python3 >/dev/null 2>&1 || { echo 'Pentad needs Python 3; install python3 and run pentad doctor again.' >&2; exit 1; }
  doctor_helper=$(helper_path pentad_doctor.py "$install_root") || exit 1
  exec python3 "$doctor_helper" --qs "$qs_binary" --root "$install_root"
fi
if [ "$command_name" = setup ]; then
  command -v python3 >/dev/null 2>&1 || { echo 'Pentad needs Python 3; install python3 and run pentad setup again.' >&2; exit 1; }
  setup_helper=$(helper_path pentad_setup.py "$install_root") || exit 1
  if [ "$setup_undo" -eq 1 ]; then
    exec python3 "$setup_helper" --undo --qs "$qs_binary" --root "$install_root"
  fi
  exec python3 "$setup_helper" --qs "$qs_binary" --root "$install_root"
fi
if [ "$command_name" = lock ]; then
  # The lock screen is its own Quickshell instance (keyed by lock.qml), so stopping or restarting
  # the shell never ends it. It exits 0 only after an unlock; anything else means the session
  # may not be locked, so hand over to hyprlock when it is installed.
  # A lock counts only once lock.qml writes "locked" to the state file: a qs that failed to load
  # the entry keeps running without any lock, and one that is unlocking is about to end.
  lock_entry=$install_root/lock.qml
  lock_state=${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/pentad-lock.state}
  lock_status=1
  if [ -f "$lock_entry" ]; then
    running=$("$qs_binary" list --path "$lock_entry" --json 2>/dev/null) || running=
    case "$running" in
      *'"id"'*)
        if [ -n "$lock_state" ] && [ "$(cat "$lock_state" 2>/dev/null)" = locked ]; then exit 0; fi
        echo 'Replacing a Pentad lock screen that holds no confirmed lock.' >&2
        "$qs_binary" kill --path "$lock_entry" >/dev/null 2>&1 || true
        ;;
    esac
    [ -z "$lock_state" ] || rm -f -- "$lock_state"
    # Without the crash handler a crash ends the process, so the fallback below can take over
    # instead of Quickshell relaunching the lock in place, possibly in a loop.
    QS_DISABLE_CRASH_HANDLER=1 PENTAD_LOCK_STATE=$lock_state "$qs_binary" --no-duplicate --path "$lock_entry" &
    lock_pid=$!
    if [ -n "$lock_state" ]; then
      waited=0
      until [ "$(cat "$lock_state" 2>/dev/null)" = locked ]; do
        kill -0 "$lock_pid" 2>/dev/null || break
        waited=$((waited + 1))
        if [ "$waited" -ge 50 ]; then
          echo 'The Pentad lock screen did not confirm a lock within 5 seconds.' >&2
          kill "$lock_pid" 2>/dev/null || true
          break
        fi
        sleep 0.1
      done
    fi
    lock_status=0
    wait "$lock_pid" || lock_status=$?
    [ "$lock_status" -ne 0 ] || exit 0
    printf 'The Pentad lock screen exited with status %s.\n' "$lock_status" >&2
  else
    printf 'The Pentad lock screen is missing: %s\n' "$lock_entry" >&2
  fi
  lock_fallback "$lock_status"
fi
[ -d "$install_root" ] || { printf 'Pentad Quickshell root does not exist: %s\n' "$install_root" >&2; exit 1; }

if [ "$command_name" = stop ] || [ "$command_name" = restart ]; then
  remaining=$("$qs_binary" list --path "$install_root" --json)
  case "$remaining" in
    *'"id"'*)
      "$qs_binary" kill --path "$install_root"
      attempts=0
      while :; do
        remaining=$("$qs_binary" list --path "$install_root" --json)
        case "$remaining" in *'"id"'*) ;; *) break ;; esac
        attempts=$((attempts + 1))
        [ "$attempts" -lt 50 ] || { echo 'Pentad did not stop within 5 seconds.' >&2; exit 1; }
        sleep 0.1
      done
      ;;
    *) echo 'Pentad is not running.' ;;
  esac
  [ "$command_name" != stop ] || exit 0
  command_name=start
fi
case "$command_name" in
  status) exec "$qs_binary" list --path "$install_root" ;;
  logs) exec "$qs_binary" log --follow --path "$install_root" ;;
esac

if [ "$command_name" = start ]; then
  qs_version=$("$qs_binary" --version 2>&1) || { printf 'Cannot read Quickshell version: %s\n' "$qs_version" >&2; exit 1; }
  version_numbers=$(printf '%s\n' "$qs_version" | sed -nE 's/.*[^0-9]([0-9]+)\.([0-9]+)\.([0-9]+).*/\1 \2 \3/p' | head -n 1)
  [ -n "$version_numbers" ] || { printf 'Cannot parse Quickshell version: %s\n' "$qs_version" >&2; exit 1; }
  set -- $version_numbers
  major=$1 minor=$2 patch=$3
  if [ "$major" -lt 0 ] || { [ "$major" -eq 0 ] && [ "$minor" -lt 3 ]; } || { [ "$major" -eq 0 ] && [ "$minor" -eq 3 ] && [ "$patch" -lt 2 ]; }; then
    printf 'Quickshell %s is below required 0.3.2\n' "$qs_version" >&2
    exit 1
  fi
  if [ "$safe_mode" -eq 1 ]; then
    PENTAD_SAFE_MODE=1 exec "$qs_binary" --no-duplicate --path "$install_root"
  else
    exec "$qs_binary" --no-duplicate --path "$install_root"
  fi
else
  reply=$("$qs_binary" ipc --path "$install_root" call pentad request "$command_name" "$ipc_payload")
  printf '%s\n' "$reply"
  case "$reply" in '{"ok":false'*) exit 1 ;; esac
fi
